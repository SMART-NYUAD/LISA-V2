# LISA Configuration File
# Source this file before running LISA: source config.env
# Or copy to .env for automatic loading with python-dotenv

# ============================================
# System Paths
# ============================================
# Path to Unitree SDK
export UNITREE_SDK_PATH="/home/unitree/unitree_sdk2_python"

# Path to CycloneDDS installation
export CYCLONEDDS_HOME="/home/unitree/cyclonedds/install"

# ============================================
# Ollama API Configuration
# ============================================
# Base URL for Ollama API (for remote inference)
export OLLAMA_API_BASE="http://192.168.123.101:11434"

# Chat model for text conversations
export LISA_CHAT_MODEL="gemma3:12b"

# Vision model for image analysis
export LISA_VISION_MODEL="gemma3:12b"

# ============================================
# Local Ollama Configuration
# ============================================
# For local inference, use smaller models:
# export LISA_CHAT_MODEL="gemma3:4b"
# export LISA_VISION_MODEL="gemma3:4b"

# ============================================
# TTS Configuration
# ============================================
# TTS model file name (in TTS_models directory)
export TTS_MODEL_NAME="en_US-amy-medium.onnx"

# ============================================
# ASR Configuration
# ============================================
# Whisper model size: tiny.en, base.en, small.en, medium.en, large
export ASR_MODEL="tiny.en"

# ============================================
# Robot Configuration
# ============================================
# Network interface for robot communication
export ROBOT_INTERFACE="eth0"

# Enable/disable speech output (true/false)
export ENABLE_SPEECH="true"

# ============================================
# Logging Configuration
# ============================================
# Directory for log files (relative to project root)
export LOG_DIR="logs"

